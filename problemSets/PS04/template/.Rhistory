# Selecting only the numeric variables for which we want to find summary statistics
variables <- c("GNIpc", "privinv", "perclowage", "publexp",
"povsocexc", "percempl")
# Creating an empty data frame to store summary statistics
sum_stats <- data.frame(Variable = character(), Min = numeric(),
Max = numeric(), Mean = numeric(), SD = numeric())
for (variable in variables) {
min <- round(min(Final_dataset[[variable]], na.rm = T), 2)
max <- round(max(Final_dataset[[variable]], na.rm = T), 2)
mean <- round(mean(Final_dataset[[variable]], na.rm = T), 2)
sd <- round(sd(Final_dataset[[variable]], na.rm = T), 2)
sum_stats <- rbind(sum_stats, data.frame(Variable = variable,
Min = min,
Max = max,
Mean = mean,
SD = sd))
}
library(kableExtra)
kable(sum_stats, caption = "Summary statistics of variables",
label = "tab:summary_stats", format = "latex") |>
kable_styling(latex_options = "scale_down")
