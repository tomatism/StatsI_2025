# remove objects
rm(list=ls())
# detach all libraries
detachAllPackages <- function() {
basic.packages <- c("package:stats", "package:graphics", "package:grDevices", "package:utils", "package:datasets", "package:methods", "package:base")
package.list <- search()[ifelse(unlist(gregexpr("package:", search()))==1, TRUE, FALSE)]
package.list <- setdiff(package.list, basic.packages)
if (length(package.list)>0)  for (package in package.list) detach(package,  character.only=TRUE)
}
detachAllPackages()
# load libraries
pkgTest <- function(pkg){
new.pkg <- pkg[!(pkg %in% installed.packages()[,  "Package"])]
if (length(new.pkg))
install.packages(new.pkg,  dependencies = TRUE)
sapply(pkg,  require,  character.only = TRUE)
}
lapply(c("ggplot2", "tidyverse", "patchwork", "stargazer"),  pkgTest)
####################
#POLITICAL SCIENCE #
####################
#We have to create a data frame with the data given by Fried, Lagunes and Venkataramani work
polsci_df_og <- tibble(
Class = c("Upper class", "Lower class"),
'Not stopped' = c(14,7),
'Bribe requested' = c(6,7),
'Stopped/given warning' = c(7,1)
)
## Task number 1
#The idea behind the chi-squared test is to test wheter two variables have indipendent distribution
#In order to do so we need to compute the expected frequency
# Fe = (row total / grand total) * column total
##Row total
#polsci_df <- polsci_df |>
#  mutate(Row_total = rowSums(across(`Not stopped`:`Stopped/given warning`)))
##column total
#polsci_df <- polsci_df |>
#  add_row(
#    Class = "Col_total",
#    !!!colSums(polsci_df[,-1])
#  )
#RESTARTING WITH A BETTER APPROACH
#This df has everything we need but it's not tidy (the column total doesn't respect the "each varible forms one column" )
#We should pivot.longer the original one so that it respects the tidy requirements
polsci_df_long <- polsci_df_og |>
pivot_longer(-Class, names_to = "Observation", values_to = "Fo")
str(polsci_df_long)
polsci_df_long <- polsci_df_long |>
group_by(Class) |>
mutate(Rows_tot = sum(Fo)) |>
ungroup()
polsci_df_long <- polsci_df_long |>
group_by(Observation) |>
mutate(Cols_tot = sum(Fo)) |>
ungroup()
#let's define the grandtotal as the sum of the Cols_tot / 2
# [since the values are present twice, Lower and Upper class]
GT <- sum(polsci_df_long$Cols_tot) / 2
#Now we can calculate the Fe
polsci_df_long <- polsci_df_long |>
mutate(Fe = (Rows_tot * Cols_tot) / GT)
#From here we can manually calculate the Chi-squared as we have calculated all of it's component
Chi_squared <- sum(((polsci_df_long$Fo - polsci_df_long$Fe)^2)/polsci_df_long$Fe)
paste("The Chi-squared value found is:", round(Chi_squared, 4))
#"The Chi-squared value found is: 3.7912"
## Task number 2
#We can manually define df, in the og df the rows total is two and there are three columns
df <- (2-1)*(3-1)
p_value <- pchisq(Chi_squared, df, lower.tail = FALSE)
result <- ifelse(p_value < 0.1,
paste("p-value:", round(p_value, 4), "- The variables are likely associated at a 0.10 significant level"),
paste("p-value:", round(p_value, 4), "- The variables don't showcase statistically significant association"))
print(result)
# "p-value: 0.1502 - The variables don't showcase statistically significant association"
## Task number 3
#We now need to calculate the standardized residuals of our table.
#This is useful because it helps determine what in what cells the expected and observed frequencies
#were diverging the most and which one the least, it is an observable pattern of association between the cells.
polsci_df_long <- polsci_df_long |>
mutate(z_values = ((Fo - Fe) /
sqrt((Fe)*(1 - Rows_tot / GT) * (1 - Cols_tot / GT))))
View(polsci_df_long)
# Create the contingency table
ctable <- as.matrix(polsci_df_og[,-1])  # remove the Class column
# Run chi-squared test
chi_result <- chisq.test(ctable)
# Chi-squared value
chi_result$statistic
# p-value
chi_result$p.value
# Standardized residuals
chi_result$stdres
