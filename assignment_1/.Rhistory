upper_95 <- avg_IQ + t * SE
CI_IQ <- c(lower_95,upper_95)
lower_95
CI_IQ
test_stat <- (avg_IQ - 100) - SE
test_stat
#Proceeding calculating the p-value
p_value <- qt(-abs(test_stat), df = 24)
test_stat <- (avg_IQ - 100) - SE
# -4.178575
#Proceeding calculating the p-value
p_value <- qt(-abs(test_stat), df = 24)
p_value <- pt(-abs(test_stat), df = 24)
p_value
test_stat <- (avg_IQ - 100) / SE
test_stat
## 2
#Stating hypothesis:
#Ho: avg_IQ <= 100 // Ha: avg_IQ > 100
#Finding appropriate test stat
test_stat <- (avg_IQ - 100) / SE
# -0.5957439
#Proceeding calculating the p-value
p_value <- pt(-abs(test_stat), df = 24, lower.tail =  FALSE)
#Evaluating the results
alpha <- 0.05
result <- ifelse(p_value > alpha,
"Ho cannot be rejected",
"Ho is rejected")
result
print(result)
